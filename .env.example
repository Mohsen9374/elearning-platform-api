# Copy this file to .env and adjust the values.

NODE_ENV=development
PORT=3000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/elearning

# JWT — use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Allowed CORS origin(s) for the frontend
CORS_ORIGIN=*

# Where uploaded files are stored
UPLOAD_DIR=public/uploads

# Used by `npm run seed:admin`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
